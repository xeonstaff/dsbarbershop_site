---
const { activePage = "home" } = Astro.props;
import { Navigation, Logo, MobileNav } from "@components/common";
import { ActionError } from "astro:actions";
console.log(`activepage - logownav: ${activePage}`);
const links = [
  {
    path: "/",
    title: "Home",
  },
  {
    path: "/locations/theflats",
    title: "The Flats",
  },
  {
    path: "/locations/thegreene",
    title: "The Greene",
  },
  {
    path: "/about",
    title: "About us",
  },
];
---

<div class="header-wrapper">
  <div class="header_layout">
    <div class="header_logo">
      <Logo customWidth="50" hasBiznasName="true" />
    </div>
    <div class="header_nav">
      <Navigation
        siteLinks={links}
        class="header_navigation_links"
        activePage={activePage.replace(/\s+/g, "").toLowerCase()}
      />
      <MobileNav siteLinks={links} 
        class="mobile_navigaton_link"
      />
    </div>
  </div>
  
<!-- stacked temporary announcements -->
<div class="toast-stack">
  <div class="toast-container toast-red">
    <div class="toast-content">
      <div class="toast-text">
        <b>Trey</b> is now working out of  <a href="/locations/theflats">The Flats!</a>
      </div>
      <button class="close-button" aria-label="Close toast">×</button>
    </div>
  </div>

  <!-- toast notification #2 -->
  <!-- <div class="toast-container toast-gold">
    <div class="toast-content">
      <div class="toast-text">
        <b>Chase</b> is back full-time! He'll be working out of <a href="/locations/theflats">The Flats.</a>
      </div>
      <button class="close-button" aria-label="Close toast">×</button>
    </div>
  </div>
</div> -->

<script>
  const toasts = document.querySelectorAll(".toast-container");

  window.addEventListener("load", () => {
    setTimeout(() => {
      toasts.forEach((toast) => toast.classList.add("show"));
    }, 100);
  });

  toasts.forEach((toast) => {
    const closeButton = toast.querySelector(".close-button");

    closeButton?.addEventListener("click", () => {
      toast.classList.remove("show");

      setTimeout(() => {
        toast.remove();
      }, 400);
    });
  });
</script>

<style>
  .header-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100vw;
  }

  /* Existing styles */
  .header_layout {
    height: 90px;
    width: 100vw;
    display: flex;
    position: relative;
    z-index: 10;
    background-color: var(--header_layout-backgroundColor, rgba(0, 0, 0, 0.8));
    align-items: center;
    justify-content: space-between;
  }
  
  .header_logo {
    margin-left: 30px;
    width: 180px;
  }
  
  .header_nav {
    margin-right: 15px;
    font-size: 1em;
    width: 700px;
    @media screen and (max-width: 700px) {
      font-size: 1.5vw;
    }
  }
  
  .mobile_navigaton_link {
    display: none;
  }
  
  .header_navigation_links {
    display: block;
  }
  
  @media screen and (max-width: 480px) {
    .header_navigation_links {
      display: none;
    }
    .mobile_navigaton_link {
      display: flex;
      justify-content: end;
    }
    .header_logo {
      margin-left: 10px;
      width: 80px;
    }

  }

  /* Toast styles */

  .toast-stack {
  position: absolute;
  top: 100px;
  left: 50%;
  transform: translateX(-50%);
  width: min(980px, calc(100vw - 32px));
  z-index: 9;

  display: flex;
  flex-direction: column;
  gap: 8px;
}

.toast-container {
  width: 100%;
  opacity: 0;
  transform: translateY(-10px);

  transition:
    transform 0.35s ease,
    opacity 0.35s ease;
}

.toast-container.show {
  opacity: 1;
  transform: translateY(0);
}

.toast-content {
  min-height: 30px;
  padding: 0.7rem 3rem 0.7rem 1.25rem;

  display: flex;
  align-items: center;
  justify-content: center;

  position: relative;

  border-radius: 12px;

  font-family: "barlow";
  font-size: 0.95rem;
  color: rgba(255, 255, 255, 0.96);

  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);

  box-shadow:
    0 8px 24px rgba(0, 0, 0, 0.18),
    inset 0 1px 0 rgba(255, 255, 255, 0.08);

  border: 1px solid rgba(255, 255, 255, 0.08);
}

/* muted burgundy */
.toast-red .toast-content {
  background: rgba(190, 55, 55, 0.96);
}

/* warm muted bronze */
.toast-gold .toast-content {
  background: rgba(202, 137, 38, 0.96);
}

.toast-text {
  text-align: center;
  white-space: nowrap;
  letter-spacing: 0.01em;
}

.toast-text b {
  font-weight: 600;
}

.toast-text a {
  color: rgba(255, 255, 255, 0.98);
  font-weight: 600;
  text-decoration: underline;
  text-underline-offset: 2px;
}

.close-button {
  background: rgba(255, 255, 255, 0.08);
  border: none;
  color: white;

  width: 28px;
  height: 28px;
  border-radius: 50%;

  display: grid;
  place-items: center;

  font-size: 1rem;
  line-height: 1;
  cursor: pointer;

  position: absolute;
  right: 0.75rem;
  top: 50%;
  transform: translateY(-50%);

  transition:
    background 0.2s ease,
    opacity 0.2s ease;
}

.close-button:hover {
  background: rgba(255, 255, 255, 0.16);
}

@media screen and (max-width: 700px) {
  .toast-stack {
    top: 96px;
    width: calc(100vw - 20px);
  }

  .toast-content {
    min-height: 44px;
    padding: 0.65rem 2.75rem 0.65rem 1rem;
    font-size: 0.82rem;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    box-shadow:
      0 6px 20px rgba(0, 0, 0, 0.22),
      inset 0 1px 0 rgba(255, 255, 255, 0.14);
  }

  .toast-text {
    white-space: normal;
  }
}
</style>